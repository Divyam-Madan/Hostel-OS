NODE_ENV=development
PORT=5000
MONGODB_URI=
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Optional: if omitted, OTP codes are printed to the server console
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

HEALTH_CENTER_EMAIL=

# Optional: Gemini summaries (admin only)
GEMINI_API_KEY=
# GEMINI_MODEL=

# Frontend URL (CORS + Socket.IO)
CLIENT_ORIGIN=http://localhost:5173

# Start API even if Mongo is unreachable (503 on data routes). Use for local UI dev only.
# ALLOW_NO_DB=true

# Override default hardcoded admin if needed
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Cloudinary (optional) — required for image uploads to work
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
